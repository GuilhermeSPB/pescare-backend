DATABASE_URL="postgresql://user:password@localhost:5432/pescare?schema=public"
PORT=3000
JWT_SECRET="your_jwt_secret"

# Origens do front permitidas pelo CORS, separadas por virgula.
# Se ficar sem definir, qualquer origem e aceita (uso em dev).
# CORS_ORIGINS="http://localhost:5173"

# Quantos proxies (Nginx, Render, Cloudflare...) ficam na frente da API.
# Usado pelo rate limit pra descobrir o IP real do cliente. 0 (padrao) = nenhum.
# So aumentar se houver proxy de fato, senao o IP pode ser forjado.
# TRUST_PROXY=1
